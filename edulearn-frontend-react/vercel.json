{
  "rewrites": [
    {
      "source": "/backend-api/:path*",
      "destination": "https://api.bestbrainplus.com/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://api.bestbrainplus.com/socket.io/:path*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
