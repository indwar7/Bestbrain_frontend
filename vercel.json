{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/edutok/:path*",
      "destination": "/edulearn-frontend/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/backend-api/:path*",
      "destination": "https://api.bestbrainplus.com/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://api.bestbrainplus.com/socket.io/:path*"
    }
  ]
}
